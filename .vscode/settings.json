{
  "files.associations": {
    "*.md": "markdown",
    "*.markdown": "markdown"
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "on",
      "strings": "on",
      "other": "on"
    }
  },
  "editor.snippetSuggestions": "top",
  "markdown.preview.breaks": true,
  "markdown.preview.linkify": true,
  "markdown.preview.fontSize": 14
}
